{
  "id": "/index.html",
  "name": "TaxPlot",
  "short_name": "TaxPlot",
  "display": "standalone",
  "start_url": "./index.html",
  "scope": "./",
  "background_color": "#EEF4F5",
  "theme_color": "#00657E",
  "icons": [
    {
      "src": "apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "photos",
          "accept": ["image/*", "application/pdf"]
        }
      ]
    }
  }
}
